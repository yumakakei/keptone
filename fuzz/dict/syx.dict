#
# What libFuzzer may put into the inputs of the `syx` target (-dict): the bytes
# that start and end a system-exclusive message, the headers of the DX7's two
# dumps of voices and of its other messages, a status byte, and the steps at
# the ends of the ranges, [DEXED-SYSEX]; the group bytes of a parameter change,
# the voice group with its number's high bits, the function group, which the
# DX7's panel buttons share [AJXS-ROM], and the DX7II's switch remote; a
# switch's data; a universal bulk dump's request and classification name
# [DX7II-MANUAL]; and the TX7's: the headers of the dumps of performances and
# of the condition acknowledge, the group bytes of its parameter changes, and
# its model name [TX7-MANUAL]; and the headers of the DX7II's dumps of
# supplements, the group bytes of its supplement's, performance's and system
# set-up's parameter changes, its universal bulk dump's header and names, and
# the DX7s's system reset; the names of its micro tunings and fractional
# scalings, their groups' byte counts, the headers of their parameter changes,
# and the bytes that send four bits of a fractional scaling at their ends.

start="\xF0"
end="\xF7"
yamaha="\x43"
voice_header="\xF0\x43\x00\x00\x01\x1B"
bank_header="\xF0\x43\x00\x09\x20\x00"
voice_count="\x01\x1B"
bank_count="\x20\x00"
parameter_change="\xF0\x43\x10"
request="\xF0\x43\x20"
voice_group_high="\xF0\x43\x10\x01"
function_group="\xF0\x43\x10\x08"
switch_remote="\xF0\x43\x10\x1B"
universal_request="\xF0\x43\x20\x7E"
classification="LM  "
released="\x00"
largest_switches="\x3F"
performance_header="\xF0\x43\x00\x01\x00\x5E"
performances_header="\xF0\x43\x00\x02\x20\x00"
condition_header="\xF0\x43\x00\x7D\x00\x10"
performance_group="\xF0\x43\x10\x04"
tx_group="\xF0\x43\x10\x11"
operator_select="\x01\x1C"
model="8950  "
supplement_header="\xF0\x43\x00\x05\x00\x31"
supplements_header="\xF0\x43\x00\x06\x08\x60"
supplement_group="\xF0\x43\x10\x18"
performance_group="\xF0\x43\x10\x19"
universal_dump="\xF0\x43\x00\x7E"
performance_edit="LM  8973PE"
performance_memory="LM  8973PM"
system_setup="LM  8973S "
system_reset="\x1B\x2E"
micro_tuning_edit="LM  MCRYE "
micro_tuning_memory="LM  MCRYM"
micro_tuning_cartridge="LM  MCRYC "
scaling_edit="LM  FKSYE "
scaling_cartridge="LM  FKSYC "
micro_tuning_count="\x02\x0A"
scaling_count="\x03\x76"
micro_tuning_change="\xF0\x43\x10\x18\x7E"
scaling_change="\xF0\x43\x10\x18\x7F"
nibble_zero="\x30"
note_on="\x90"
largest_level="\x63"
beyond_level="\x64"
largest_byte="\x7F"
detune_beyond="\x0E"
