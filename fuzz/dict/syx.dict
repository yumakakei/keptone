#
# What libFuzzer may put into the inputs of the `syx` target (-dict): the bytes
# that start and end a system-exclusive message, the headers of the DX7's two
# dumps of voices and of its other messages, a status byte, and the steps at
# the ends of the ranges, [DEXED-SYSEX].

start="\xF0"
end="\xF7"
yamaha="\x43"
voice_header="\xF0\x43\x00\x00\x01\x1B"
bank_header="\xF0\x43\x00\x09\x20\x00"
voice_count="\x01\x1B"
bank_count="\x20\x00"
parameter_change="\xF0\x43\x10"
request="\xF0\x43\x20"
note_on="\x90"
largest_level="\x63"
beyond_level="\x64"
largest_byte="\x7F"
detune_beyond="\x0E"
