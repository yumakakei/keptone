#
# What libFuzzer may put into the inputs of the `scl` target (-dict): the
# comment mark, the three ends of a line, what a pitch is written with, a part
# of a ratio at the end of 64 bits and beyond it, and a byte of ISO 8859-1.

comment="!"
line_feed="\x0A"
carriage_return="\x0D"
both_ends="\x0D\x0A"
period="."
slash="/"
minus="-"
space=" "
tab="\x09"
octave="2/1"
octave_in_cents="1200.0"
largest_part="18446744073709551615"
beyond_part="18446744073709551616"
latin_e_acute="\xE9"
