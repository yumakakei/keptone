#
# What libFuzzer may put into the inputs of the `kbm` target (-dict): the
# comment mark, the ends of a line, the mark of an unmapped key, the ends of
# MIDI's keys and past them, and a frequency.

comment="!"
line_feed="\x0A"
carriage_return="\x0D"
unmapped="x"
minus="-"
period="."
lowest_key="0"
highest_key="127"
beyond_keys="128"
frequency="440.0"
